{
  "expo": {
    "name": "water-supply",
    "slug": "water-supply",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "water-supply",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abdullahrizwan.watersupply",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abdullahrizwan.watersupply"
    },
    "web": {
      "favicon": "./assets/Splashing around the water jug.png"
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", {
        "image": "./assets/Splashing around the water jug.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      }]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ff9263c1-0a02-4d52-b2bd-81e8fefece1a"
      }
    }
  }
}
